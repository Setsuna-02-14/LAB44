#/* $begin ncopy-ys */
##################################################################
# ncopy.ys - Copy a src block of len words to dst.
# Return the number of positive words (>0) contained in src array.
#
# Author: adapted/optimized for LAB44 Part C
# Notes / summary of optimizations:
# 1. 8-way loop unrolling: process 8 words per iteration to amortize loop overhead.
# 2. "poke the bubble" technique: insert independent memory ops between
#    instructions that would otherwise create pipeline bubbles (mrmovq -> andq -> jle).
# 3. Balanced binary-tree remainder routing so remainder needs only ~3 tests.
# 4. Save/restore callee-saved registers used (%rbx, %r12, %r13, %r14).
##################################################################
# Do not modify this portion
# %rdi = src, %rsi = dst, %rdx = len
ncopy:
    # Save callee-saved registers that we use, so caller sees no change.
    # pushq/popq exist in the y86 subset used in the lab.
    pushq %rbx
    pushq %r12
    pushq %r13
    pushq %r14

    # initialize count to 0 (count stored in %rax)
    irmovq $0, %rax

    # prepare for 8-way unrolling: subtract 8 and check
    iaddq $-8, %rdx
    jl handle_remainder

loop_unrolling_8_way:
    # load 8 source words into distinct registers to avoid RAW hazards
    mrmovq (%rdi), %r8
    mrmovq 8(%rdi), %r9
    mrmovq 16(%rdi), %r10
    mrmovq 24(%rdi), %r11
    mrmovq 32(%rdi), %r12
    mrmovq 40(%rdi), %r13
    mrmovq 48(%rdi), %r14
    mrmovq 56(%rdi), %rcx

    # For each loaded value: set flags (andq), store (rmmovq) inserted between andq and jle to
    # give the branch time to observe condition (poke the bubble), then conditionally increment %rax.
judge_and_write_num_0:
    andq %r8, %r8
    rmmovq %r8, (%rsi)
    jle judge_and_write_num_1
    iaddq $1, %rax
judge_and_write_num_1:
    andq %r9, %r9
    rmmovq %r9, 8(%rsi)
    jle judge_and_write_num_2
    iaddq $1, %rax
judge_and_write_num_2:
    andq %r10, %r10
    rmmovq %r10, 16(%rsi)
    jle judge_and_write_num_3
    iaddq $1, %rax
judge_and_write_num_3:
    andq %r11, %r11
    rmmovq %r11, 24(%rsi)
    jle judge_and_write_num_4
    iaddq $1, %rax
judge_and_write_num_4:
    andq %r12, %r12
    rmmovq %r12, 32(%rsi)
    jle judge_and_write_num_5
    iaddq $1, %rax
judge_and_write_num_5:
    andq %r13, %r13
    rmmovq %r13, 40(%rsi)
    jle judge_and_write_num_6
    iaddq $1, %rax
judge_and_write_num_6:
    andq %r14, %r14
    rmmovq %r14, 48(%rsi)
    jle judge_and_write_num_7
    iaddq $1, %rax
judge_and_write_num_7:
    andq %rcx, %rcx
    rmmovq %rcx, 56(%rsi)
    jle update_expr
    iaddq $1, %rax

update_expr:
    # Advance pointers and loop counter for next 8 elements
    iaddq $64, %rdi
    iaddq $64, %rsi
    iaddq $-8, %rdx
    jge loop_unrolling_8_way

# ---------------- remainder handling ----------------
# After the initial subtract of 8, len in %rdx is in [-8, ...).
# We add 4 and branch into balanced remainder dispatcher to find exact remainder handler.
handle_remainder:
    # map [-8..-1] to [-4..3] by +4
    iaddq $4, %rdx
    jl handle_remainder_0_to_3

handle_remainder_4_to_7:
    # now rdX in [0..3] -> subtract 2 => [-2..1]
    iaddq $-2, %rdx
    jl handle_remainder_4_to_5

handle_remainder_6_to_7:
    # rdX in [0..1]
    # load candidate words and branch to correct handler; use mrmovq then je to "poke bubble"
    mrmovq 40(%rdi), %rbx
    je handle_remainder_6
    mrmovq 48(%rdi), %rbx
    jmp handle_remainder_7

handle_remainder_4_to_5:
    iaddq $1, %rdx
    mrmovq 32(%rdi), %rbx
    je handle_remainder_5
    mrmovq 24(%rdi), %rbx
    jmp handle_remainder_4

handle_remainder_0_to_3:
    # rdX in [-4..-1] -> add 2 => [-2..1]
    iaddq $2, %rdx
    jl handle_remainder_0_to_1

handle_remainder_2_to_3:
    mrmovq 8(%rdi), %rbx
    je handle_remainder_2
    mrmovq 16(%rdi), %rbx
    jmp handle_remainder_3

handle_remainder_0_to_1:
    iaddq $1, %rdx
    mrmovq (%rdi), %rbx
    je handle_remainder_1
    # remainder == 0 -> nothing to do
    # Restore callee-saved registers before returning
    popq %r14
    popq %r13
    popq %r12
    popq %rbx
    ret

# ---------------- actual remainder handlers ----------------
# Each handler assumes %rbx already holds the next value to be processed.
# The pattern alternates mrmovq and jle to allow forwarding and reduce bubbles.
handle_remainder_7:
    andq %rbx, %rbx
    rmmovq %rbx, 48(%rsi)
    mrmovq 40(%rdi), %rbx
    jle handle_remainder_6
    iaddq $1, %rax
handle_remainder_6:
    andq %rbx, %rbx
    rmmovq %rbx, 40(%rsi)
    mrmovq 32(%rdi), %rbx
    jle handle_remainder_5
    iaddq $1, %rax
handle_remainder_5:
    andq %rbx, %rbx
    rmmovq %rbx, 32(%rsi)
    mrmovq 24(%rdi), %rbx
    jle handle_remainder_4
    iaddq $1, %rax
handle_remainder_4:
    andq %rbx, %rbx
    rmmovq %rbx, 24(%rsi)
    mrmovq 16(%rdi), %rbx
    jle handle_remainder_3
    iaddq $1, %rax
handle_remainder_3:
    andq %rbx, %rbx
    rmmovq %rbx, 16(%rsi)
    mrmovq 8(%rdi), %rbx
    jle handle_remainder_2
    iaddq $1, %rax
handle_remainder_2:
    andq %rbx, %rbx
    rmmovq %rbx, 8(%rsi)
    mrmovq (%rdi), %rbx
    jle handle_remainder_1
    iaddq $1, %rax
handle_remainder_1:
    andq %rbx, %rbx
    rmmovq %rbx, (%rsi)
    jle Done
    iaddq $1, %rax

Done:
    # Restore callee-saved registers before returning
    popq %r14
    popq %r13
    popq %r12
    popq %rbx
    ret

End:
#/* $end ncopy-ys */
